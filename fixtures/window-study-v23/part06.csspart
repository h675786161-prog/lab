JgiVBmTviYhX5mz7KvONS7/evJ/rXDGhLo/Ll1kV5cXcy1pZRyI9l8zhheRlKFTpoOaJDMGU3aZw9xaWle9kntigAAAAAAA=");}
body{background:linear-gradient(135deg,#bbb0c2,#d4cad3);color:var(--ws-ink);font-family:'Noto Serif CJK SC','Noto Serif SC',Georgia,serif;}
#chat{display:flex!important;flex-direction:column;gap:26px;padding:16px 22px 60px!important;overflow-x:hidden!important;align-items:center!important;}
#chat>.mes{position:relative!important;display:flex!important;flex-direction:column!important;flex:0 0 auto!important;width:min(100%,680px)!important;max-width:680px!important;min-width:0!important;margin:0 auto!important;padding:0!important;border:0!important;background:transparent!important;box-shadow:none!important;overflow:visible!important;isolation:isolate;container-type:inline-size;--ws-art-width:min(100cqw,600px);--ws-art-height:min(49.4395cqw,296.637px);--ws-info-top:calc(var(--ws-art-height)*.715);--ws-info-width:calc(var(--ws-art-width)*.52);--ws-info-height:58px;--ws-head-height:max(calc(var(--ws-art-height)*1.04),calc(var(--ws-info-top) + var(--ws-info-height) + 10px));--ws-paper-start:calc(var(--ws-art-height)*.535);--ws-corner-width:min(52cqw,244px);--ws-corner-outset:clamp(12px,3.4cqw,26px);}
#chat>.mes::before{content:'';position:absolute;inset:var(--ws-paper-start) 0 0;background:linear-gradient(112deg,#fffcf6 20%,#f1eaf3),var(--ws-paper);border:1px solid #c3b8c1;border-radius:16px 16px 12px 12px;box-shadow:inset 0 0 0 2px #fffdf6c7,0 3px 10px #41334719;pointer-events:none;z-index:-1;}
#chat>.mes:not([is_system='true'])::after{content:'';position:absolute;right:calc(var(--ws-corner-outset)*-1);bottom:calc(var(--ws-corner-width)*-.30);width:var(--ws-corner-width);aspect-ratio:3/2;background:var(--ws-body-corner) center/contain no-repeat;pointer-events:none;z-index:1;transform:rotate(1.2deg);transform-origin:72% 72%;}
#chat>.mes>.mesAvatarWrapper{position:relative!important;width:100%!important;height:var(--ws-head-height)!important;flex:none!important;margin:0!important;padding:0!important;overflow:visible!important;isolation:isolate;z-index:2;}
#chat>.mes>.mesAvatarWrapper::after{content:'';position:absolute;top:0;left:50%;transform:translateX(-50%);width:var(--ws-art-width);height:var(--ws-art-height);background:var(--ws-head-art) center/contain no-repeat;z-index:2;pointer-events:none;}
#chat>.mes>.mesAvatarWrapper::before{content:'';position:absolute;left:calc(50% - var(--ws-info-width)/2);top:var(--ws-info-top);width:var(--ws-info-width);height:var(--ws-info-height);box-sizing:border-box;border:1px solid #b9a7c7;border-radius:3px 3px 7px 7px;background:linear-gradient(#e7dced,#d9cbe2);box-shadow:inset 0 0 0 2px #f5edf76b;z-index:1;pointer-events:none;}
#chat>.mes .avatar{position:absolute!important;left:calc(50% - var(--ws-art-width)*.36);top:calc(var(--ws-art-height)*.09);width:calc(var(--ws-art-width)*.27)!important;height:calc(var(--ws-art-height)*.61)!important;border-radius:50%!important;overflow:hidden!important;z-index:1!important;background:#d8c8dc;}
#chat>.mes .avatar img,#chat>.mes .avatar>div{width:100%!important;height:100%!important;object-fit:cover!important;}
#chat>.mes .mesIDDisplay,#chat>.mes .mes_timer,#chat>.mes .tokenCounterDisplay{position:absolute!important;top:calc(var(--ws-info-top) + 33px)!important;width:calc(var(--ws-info-width)/3 - 6px)!important;text-align:center!important;white-space:nowrap!important;font-size:11px!important;color:#7a6a80!important;z-index:4!important;}
#chat>.mes .mesIDDisplay{left:calc(50% - var(--ws-art-width)*.17)!important}#chat>.mes .mes_timer{left:calc(50% - var(--ws-info-width)/6)!important}#chat>.mes .tokenCounterDisplay{left:calc(50% + var(--ws-art-width)*.07)!important}
#chat>.mes>.mes_block{position:static!important;width:100%!important;min-width:0!important;margin:0!important;padding:16px 30px 50px!important;border:0!important;background:transparent!important;box-shadow:none!important;}
#chat .ch_name{position:static!important;height:0!important;margin:0!important;padding:0!important;}
#chat .name_text{position:absolute!important;left:calc(50% - var(--ws-art-width)*.20)!important;top:calc(var(--ws-art-height)*.62)!important;width:calc(var(--ws-art-width)*.40)!important;text-align:center!important;font-size:18px!important;color:#69576d!important;z-index:4!important;}
#chat .timestamp{position:absolute!important;top:calc(var(--ws-info-top) + 7px)!important;left:calc(50% - var(--ws-info-width)/2 + 8px)!important;width:calc(var(--ws-info-width) - 16px)!important;text-align:center!important;font-size:10px!important;color:#77677e!important;z-index:4!important;}
#chat .mes_text{position:relative!important;z-index:2!important;padding:0!important;margin:0!important;line-height:1.9!important;font-size:16px!important;overflow-wrap:anywhere!important;}
#chat>.mes:not([is_system='true'])>.mes_block::before{content:'';position:absolute;top:calc(var(--ws-paper-start) - var(--ws-corner-width)*.20);left:calc(var(--ws-corner-outset)*-1);width:var(--ws-corner-width);aspect-ratio:3/2;background:var(--ws-top-corner) center/contain no-repeat;pointer-events:none;z-index:1;transform:rotate(-1.2deg);transform-origin:28% 28%;}
#chat .mes_text p{margin:0 0 13px}#chat .mes_text p:last-child{margin-bottom:0}
#form_sheld,#send_form{background:#faf5fb!important;border-color:#c7b6cf!important;}
@media(max-width:700px){#chat{padding:8px 8px 28px!important;gap:20px}#chat>.mes{--ws-corner-width:min(48cqw,190px);--ws-corner-outset:8px;width:100%!important}#chat>.mes>.mes_block{padding:14px 23px 44px!important}#chat .mes_text{font-size:15px!important;line-height:1.9!important}}